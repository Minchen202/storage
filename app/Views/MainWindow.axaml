<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="app.MainWindow"
        Title="P2P Storage"
        Width="1400"
        Height="900"
        MinWidth="1200"
        MinHeight="800"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="44"
        SystemDecorations="None">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#30FFFFFF"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        
        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>
        
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#4F46E5"/>
            <Setter Property="Background" Value="#20FFFFFF"/>
        </Style>
    </Window.Styles>

    <Panel>
        <!-- Acrylic Material Background - adapts to Windows system wallpaper -->
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="#0F172A"
                    TintOpacity="0.7"
                    MaterialOpacity="0.85"/>
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <!-- Main content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0"
                    x:Name="TitleBar"
                    Background="#15FFFFFF"
                    BorderBrush="#20FFFFFF"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Icon and Title -->
                    <StackPanel Grid.Column="0" 
                               Orientation="Horizontal" 
                               Spacing="12"
                               VerticalAlignment="Center">
                        <!-- Custom Cloud SVG Icon -->
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#4F46E5" 
                                      Data="M12,2C9.24,2 7,4.24 7,7C4.79,7 3,8.79 3,11C3,13.21 4.79,15 7,15H18C19.66,15 21,13.66 21,12C21,10.34 19.66,9 18,9C18,5.69 15.31,3 12,3M12,4C14.21,4 16,5.79 16,8H18C18.55,8 19,8.45 19,9C19,9.55 18.55,10 18,10H7C5.9,10 5,10.9 5,12C5,13.1 5.9,14 7,14H18C18.55,14 19,13.55 19,13H18V11H20C20.55,11 21,11.45 21,12C21,13.66 19.66,15 18,15H7C4.79,15 3,13.21 3,11C3,8.79 4.79,7 7,7C7,4.24 9.24,2 12,2Z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="P2P Storage" 
                                  FontSize="13" 
                                  FontWeight="SemiBold"
                                  Foreground="#E2E8F0"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="2" 
                               Orientation="Horizontal" 
                               Spacing="2">
                        <Button x:Name="MinimizeButton"
                               Content="−"
                               Width="46"
                               Height="32"
                               Background="Transparent"
                               Foreground="#94A3B8"
                               FontSize="16"
                               Padding="0"
                               CornerRadius="6"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center"/>
                        <Button x:Name="MaximizeButton"
                               Content="□"
                               Width="46"
                               Height="32"
                               Background="Transparent"
                               Foreground="#94A3B8"
                               FontSize="14"
                               Padding="0"
                               CornerRadius="6"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center"/>
                        <Button x:Name="CloseButton"
                               Content="✕"
                               Width="46"
                               Height="32"
                               Background="Transparent"
                               Foreground="#94A3B8"
                               FontSize="16"
                               Padding="0"
                               CornerRadius="6"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content below title bar -->
            <Grid Grid.Row="1" Margin="0">
            <!-- Login Screen -->
            <Border x:Name="LoginScreen" 
                    IsVisible="True"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Border Background="#20FFFFFF"
                        CornerRadius="24"
                        Padding="60,50"
                        BoxShadow="0 25 50 -12 #40000000">
                    <Border.Effect>
                        <BlurEffect Radius="0"/>
                    </Border.Effect>
                    
                    <StackPanel Width="420" Spacing="24">
                        <!-- Logo and title -->
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <Border Width="80" Height="80" 
                                    CornerRadius="20"
                                    Background="#4F46E5"
                                    BoxShadow="0 10 25 -5 #604F46E5">
                                <Viewbox Width="48" Height="48" 
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="White" 
                                              Data="M12,2C9.24,2 7,4.24 7,7C4.79,7 3,8.79 3,11C3,13.21 4.79,15 7,15H18C19.66,15 21,13.66 21,12C21,10.34 19.66,9 18,9C18,5.69 15.31,3 12,3M12,4C14.21,4 16,5.79 16,8H18C18.55,8 19,8.45 19,9C19,9.55 18.55,10 18,10H7C5.9,10 5,10.9 5,12C5,13.1 5.9,14 7,14H18C18.55,14 19,13.55 19,13H18V11H20C20.55,11 21,11.45 21,12C21,13.66 19.66,15 18,15H7C4.79,15 3,13.21 3,11C3,8.79 4.79,7 7,7C7,4.24 9.24,2 12,2Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            
                            <TextBlock Text="P2P Storage" 
                                      FontSize="32" 
                                      FontWeight="Bold"
                                      Foreground="White"
                                      HorizontalAlignment="Center"
                                      Margin="0,8,0,0"/>
                            
                            <TextBlock Text="Decentralized file storage for everyone" 
                                      FontSize="14" 
                                      Foreground="#94A3B8"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Input fields -->
                        <StackPanel Spacing="16" Margin="0,12,0,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Email" 
                                          FontSize="13" 
                                          FontWeight="SemiBold"
                                          Foreground="#CBD5E1"/>
                                <TextBox x:Name="EmailBox" 
                                        Watermark="you@example.com"
                                        Height="48"/>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Password" 
                                          FontSize="13" 
                                          FontWeight="SemiBold"
                                          Foreground="#CBD5E1"/>
                                <TextBox x:Name="PasswordBox" 
                                        PasswordChar="•"
                                        Watermark="••••••••"
                                        Height="48"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Error message -->
                        <TextBlock x:Name="AuthError" 
                                  IsVisible="False"
                                  TextWrapping="Wrap"
                                  Foreground="#EF4444"
                                  FontSize="13"
                                  Margin="0,-8,0,0"/>

                        <!-- Buttons -->
                        <StackPanel Spacing="12">
                            <Button x:Name="LoginButton"
                                   Click="OnLoginClick"
                                   Content="Sign In"
                                   Background="#4F46E5"
                                   Foreground="White"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center"
                                   Height="48"
                                   FontSize="15"/>
                            
                            <Button x:Name="RegisterButton"
                                   Click="OnRegisterClick"
                                   Content="Create Account"
                                   Background="#20FFFFFF"
                                   Foreground="White"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center"
                                   Height="48"
                                   FontSize="15"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Main App Screen -->
            <Grid x:Name="AppScreen" 
                  IsVisible="False"
                  Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Border Grid.Row="0"
                        Background="#15FFFFFF"
                        CornerRadius="16"
                        Padding="24,16"
                        Margin="0,0,0,20"
                        BoxShadow="0 4 6 -1 #30000000">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                            <Viewbox Width="32" Height="32">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#4F46E5" 
                                          Data="M12,2C9.24,2 7,4.24 7,7C4.79,7 3,8.79 3,11C3,13.21 4.79,15 7,15H18C19.66,15 21,13.66 21,12C21,10.34 19.66,9 18,9C18,5.69 15.31,3 12,3M12,4C14.21,4 16,5.79 16,8H18C18.55,8 19,8.45 19,9C19,9.55 18.55,10 18,10H7C5.9,10 5,10.9 5,12C5,13.1 5.9,14 7,14H18C18.55,14 19,13.55 19,13H18V11H20C20.55,11 21,11.45 21,12C21,13.66 19.66,15 18,15H7C4.79,15 3,13.21 3,11C3,8.79 4.79,7 7,7C7,4.24 9.24,2 12,2Z"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="P2P Storage" 
                                          FontSize="16" 
                                          FontWeight="Bold"
                                          Foreground="White"/>
                                <TextBlock x:Name="UserEmailText"
                                          Text=""
                                          FontSize="12"
                                          Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                            <Border Background="#1510B981" 
                                    CornerRadius="20"
                                    Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="●" 
                                              Foreground="#10B981"
                                              FontSize="12"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="Connected" 
                                              Foreground="#10B981"
                                              FontSize="12"
                                              FontWeight="SemiBold"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main content area -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar -->
                    <Border Grid.Column="0"
                            Background="#15FFFFFF"
                            CornerRadius="16"
                            Padding="16"
                            Margin="0,0,20,0"
                            BoxShadow="0 4 6 -1 #30000000">
                        <StackPanel Spacing="8">
                            <Button x:Name="FilesTab"
                                   Click="OnFilesTabClick"
                                   Background="#4F46E5"
                                   Foreground="White"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Height="44"
                                   Padding="16,0">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="📁" FontSize="16"/>
                                    <TextBlock Text="My Files" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="UploadTab"
                                   Click="OnUploadTabClick"
                                   Background="#10FFFFFF"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Height="44"
                                   Padding="16,0">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="⬆" FontSize="16"/>
                                    <TextBlock Text="Upload" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="StatsTab"
                                   Click="OnStatsTabClick"
                                   Background="#10FFFFFF"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Height="44"
                                   Padding="16,0">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="📊" FontSize="16"/>
                                    <TextBlock Text="Statistics" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="SettingsTab"
                                   Click="OnSettingsTabClick"
                                   Background="#10FFFFFF"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Height="44"
                                   Padding="16,0">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="⚙" FontSize="16"/>
                                    <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- Storage info card -->
                            <Border Background="#10FFFFFF"
                                    CornerRadius="12"
                                    Padding="16"
                                    Margin="0,24,0,0">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Storage Overview" 
                                              FontSize="13"
                                              FontWeight="SemiBold"
                                              Foreground="#CBD5E1"/>
                                    
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="StorageUsageText"
                                                  Text="0 GB / 0 GB"
                                                  FontSize="18"
                                                  FontWeight="Bold"
                                                  Foreground="White"/>
                                        
                                        <Border Height="6" 
                                                CornerRadius="3"
                                                Background="#20FFFFFF"
                                                ClipToBounds="True">
                                            <Border x:Name="StorageUsageBar"
                                                   Width="0"
                                                   HorizontalAlignment="Left"
                                                   CornerRadius="3">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                        <GradientStop Color="#4F46E5" Offset="0"/>
                                                        <GradientStop Color="#7C3AED" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Content area -->
                    <Border Grid.Column="1"
                            Background="#15FFFFFF"
                            CornerRadius="16"
                            Padding="32"
                            BoxShadow="0 4 6 -1 #30000000">
                        <Grid>
                            <!-- Files Content -->
                            <ScrollViewer x:Name="FilesContent" IsVisible="True">
                                <StackPanel Spacing="24">
                                    <Grid>
                                        <TextBlock Text="My Files" 
                                                  FontSize="28" 
                                                  FontWeight="Bold"
                                                  Foreground="White"/>
                                        <Button Content="+ Upload File"
                                               Click="OnUploadFileClick"
                                               Background="#4F46E5"
                                               Foreground="White"
                                               HorizontalAlignment="Right"
                                               Height="40"
                                               Padding="20,0"/>
                                    </Grid>

                                    <StackPanel x:Name="FilesList" Spacing="12"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Upload Content -->
                            <StackPanel x:Name="UploadContent" 
                                       IsVisible="False"
                                       Spacing="24"
                                       VerticalAlignment="Center">
                                <TextBlock Text="Upload File" 
                                          FontSize="28" 
                                          FontWeight="Bold"
                                          Foreground="White"
                                          HorizontalAlignment="Center"/>
                                
                                <Border Background="#10FFFFFF"
                                        BorderBrush="#304F46E5"
                                        BorderThickness="2"
                                        CornerRadius="16"
                                        Padding="80"
                                        HorizontalAlignment="Center">
                                    <StackPanel Spacing="20" HorizontalAlignment="Center">
                                        <TextBlock Text="📤" 
                                                  FontSize="64"
                                                  HorizontalAlignment="Center"/>
                                        <TextBlock Text="Click to select a file" 
                                                  FontSize="18"
                                                  FontWeight="SemiBold"
                                                  Foreground="White"
                                                  HorizontalAlignment="Center"/>
                                        <TextBlock Text="or drag and drop here" 
                                                  FontSize="14"
                                                  Foreground="#94A3B8"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,-12,0,0"/>
                                        <Button Content="Select File"
                                               Click="OnSelectFileClick"
                                               Background="#4F46E5"
                                               Foreground="White"
                                               Height="44"
                                               Padding="32,0"
                                               Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Stats Content -->
                            <ScrollViewer x:Name="StatsContent" IsVisible="False">
                                <StackPanel Spacing="24">
                                    <TextBlock Text="Statistics" 
                                              FontSize="28" 
                                              FontWeight="Bold"
                                              Foreground="White"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Stat Card 1 -->
                                        <Border Grid.Column="0"
                                                Background="#10FFFFFF"
                                                CornerRadius="12"
                                                Padding="24"
                                                Margin="0,0,12,0">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="💾" FontSize="32"/>
                                                <TextBlock Text="Storage Contributed" 
                                                          FontSize="12"
                                                          Foreground="#94A3B8"/>
                                                <TextBlock x:Name="StorageContributed"
                                                          Text="0 GB"
                                                          FontSize="24"
                                                          FontWeight="Bold"
                                                          Foreground="White"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Stat Card 2 -->
                                        <Border Grid.Column="1"
                                                Background="#10FFFFFF"
                                                CornerRadius="12"
                                                Padding="24"
                                                Margin="6,0">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="📦" FontSize="32"/>
                                                <TextBlock Text="Storage Quota" 
                                                          FontSize="12"
                                                          Foreground="#94A3B8"/>
                                                <TextBlock x:Name="StorageQuota"
                                                          Text="0 GB"
                                                          FontSize="24"
                                                          FontWeight="Bold"
                                                          Foreground="White"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Stat Card 3 -->
                                        <Border Grid.Column="2"
                                                Background="#10FFFFFF"
                                                CornerRadius="12"
                                                Padding="24"
                                                Margin="12,0,0,0">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="⏱" FontSize="32"/>
                                                <TextBlock Text="Total Uptime" 
                                                          FontSize="12"
                                                          Foreground="#94A3B8"/>
                                                <TextBlock x:Name="TotalUptime"
                                                          Text="0 hours"
                                                          FontSize="24"
                                                          FontWeight="Bold"
                                                          Foreground="White"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Settings Content -->
                            <StackPanel x:Name="SettingsContent" 
                                       IsVisible="False"
                                       Spacing="24">
                                <TextBlock Text="Settings" 
                                          FontSize="28" 
                                          FontWeight="Bold"
                                          Foreground="White"/>

                                <Border Background="#10FFFFFF"
                                        CornerRadius="12"
                                        Padding="24">
                                    <StackPanel Spacing="20">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="API Endpoint" 
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Foreground="#CBD5E1"/>
                                            <TextBox x:Name="ApiEndpointBox" 
                                                    Text="https://p2p-storage-api.onrender.com"
                                                    Height="44"/>
                                        </StackPanel>

                                        <Button Content="Save Settings"
                                               Click="OnSaveSettingsClick"
                                               Background="#4F46E5"
                                               Foreground="White"
                                               Height="44"
                                               HorizontalAlignment="Left"
                                               Padding="32,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            
            </Grid>
        </Grid>
    </Panel>
</Window>